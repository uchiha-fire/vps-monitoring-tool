{
  "name": "vps-docker-monitor",
  "version": "1.0.0",
  "description": "Desktop application to monitor and control Docker & Docker Compose services over VPS SSH",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:dir": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:all": "npm run build && electron-builder -l -w"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "vps",
    "ssh",
    "monitoring",
    "electron",
    "zephyrus-labs"
  ],
  "author": "Zephyrus Labs <zephyrus.labs@gmail.com> (https://zephyrus-labs.tech/)",
  "maintainers": [
    "Shubham Sharma <sharmashubham25962@gmail.com>"
  ],
  "homepage": "https://zephyrus-labs.tech/",
  "repository": {
    "type": "git",
    "url": "https://github.com/uchiha-fire/vps-monitoring-tool"
  },
  "bugs": {
    "url": "https://github.com/uchiha-fire/vps-monitoring-tool/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.3"
  }
}
